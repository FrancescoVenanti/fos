{
  "description": "No backend: Calendar from an iCal link, lock screen weather from Open-Meteo (mocked)",
  "sd": "direct-8799",
  "backend": 8799,
  "env": {"FOS_SIM_DIRECT_BASE": "http://127.0.0.1:8799"},
  "steps": [
