{
  "description": "Sleep shows the lock screen; a timed wake redraws it and sleeps again without the UI",
  "sd": "lock-weather",
  "env": {"FOS_SIM_WAKE_TIMER_MS": 3000, "FOS_SIM_CLIMATE": "22.8,51", "FOS_SIM_DIRECT_BASE": "http://127.0.0.1:8798"},
  "steps": [
    {"key": "SLEEP"},
    {"wait": 1500},
    {"shot": "asleep"}
  ],
  "after_wake": [
    {"shot": "after-timed-wake"},
    {"wait": 500}
  ]
}
