{
  "description": "Lock screen app: digital clock, cached weather, room climate; a tap closes it",
  "sd": "lock-weather",
  "env": {"FOS_SIM_DIRECT_BASE": "http://127.0.0.1:8798"},
  "steps": [
    {"key": "DOWN"},
    {"tap": [353, 175]},
    {"wait": 4000},
    {"shot": "lock"},
    {"tap": [240, 400]},
    {"shot": "closed"}
  ]
}
