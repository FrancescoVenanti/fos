Subject: [PATCH] SdSpiCard: retry failed transfers, then initialize the card again

FOs: on the reTerminal Sticky the SD card shares its SPI bus with the e-paper
panel, and its chip select does not isolate it, so the card sees display
traffic as commands. With USE_SD_CRC it rejects nearly all of them, but the
first transfer afterwards can still fail, and a stray reset leaves the card
idle until it is initialized again. Retry a failed sector transfer once, then
run begin() with the saved configuration and retry once more. Each failure is
logged with the sector and the card error (ESP32: esp_rom_printf). When
begin() fails too (the card ignores CMD0 after a brown-out), a weak
sdfat_power_cycle_hook() lets the board cut the card's supply first. If the
transfer still fails after a successful begin(), the supply is cut anyway and
the transfer tried a fourth time.

---
--- a/src/SdCard/SdSpiCard/SdSpiCard.cpp
+++ b/src/SdCard/SdSpiCard/SdSpiCard.cpp
@@ -23,6 +23,14 @@
  * DEALINGS IN THE SOFTWARE.
  */
 #include "SdSpiCard.h"
+#if defined(ARDUINO_ARCH_ESP32)
+#include <esp_rom_sys.h>
+#define SD_RETRY_LOG(op, sector, card) \
+  esp_rom_printf("[SDFAT] %s sector %lu failed: error 0x%02X data 0x%02X\n", op, \
+                 static_cast<unsigned long>(sector), (card)->errorCode(), (card)->errorData())
+#else
+#define SD_RETRY_LOG(op, sector, card)
+#endif
 //==============================================================================
 namespace {  // Avoid conflict with another Timeout class.
 class Timeout {
@@ -128,6 +136,11 @@ bool SdSpiCard::begin(SdSpiConfig spiConfig) {
   uint8_t cardType;
   uint32_t arg;
   Timeout timeout;
+  m_reinitCsPin = spiConfig.csPin;
+  m_reinitOptions = spiConfig.options;
+  m_reinitMaxSck = spiConfig.maxSck;
+  m_reinitPort = spiConfig.spiPort;
+  m_reinitValid = true;
   // Restore state to creator.
   initSharedSpiCard();
   m_errorCode = SD_CARD_ERROR_NONE;
@@ -482,7 +495,7 @@ fail:
 #endif
 }
 //------------------------------------------------------------------------------
-bool SdSpiCard::readSectors(Sector_t sector, uint8_t* dst, size_t ns) {
+bool SdSpiCard::readSectorsOnce(Sector_t sector, uint8_t* dst, size_t ns) {
 #if ENABLE_DEDICATED_SPI
   if (sdState() != READ_STATE || sector != m_curSector) {
     if (!readStart(sector)) {
@@ -660,7 +673,7 @@ fail:
   return false;
 }
 //------------------------------------------------------------------------------
-bool SdSpiCard::writeSector(Sector_t sector, const uint8_t* src) {
+bool SdSpiCard::writeSectorOnce(Sector_t sector, const uint8_t* src) {
 #ifndef OLD_WAY_WRITE_SECTOR
 #if ENABLE_DEDICATED_SPI
   if (m_dedicatedSpi) {
@@ -701,7 +714,7 @@ fail:
   return false;
 }
 //------------------------------------------------------------------------------
-bool SdSpiCard::writeSectors(Sector_t sector, const uint8_t* src, size_t ns) {
+bool SdSpiCard::writeSectorsOnce(Sector_t sector, const uint8_t* src, size_t ns) {
 #if ENABLE_DEDICATED_SPI
   if (sdState() != WRITE_STATE || m_curSector != sector) {
     if (!writeStart(sector)) {
@@ -763,3 +776,79 @@ fail:
   spiStop();
   return false;
 }
+//------------------------------------------------------------------------------
+// When another device shares the SPI bus and the card's chip select does not
+// isolate it, the card sees that traffic as commands. With CRC on it rejects
+// almost all of them, but the first transfer afterwards can still fail, and a
+// stray reset leaves the card idle until it is initialized again. Retry once,
+// then initialize the card and retry once more.
+// A card that ignores CMD0 has locked up (brown-out) and only answers again after
+// its supply is cut. The board may provide this hook to power-cycle the card;
+// it returns false when it cannot.
+extern "C" __attribute__((weak)) bool sdfat_power_cycle_hook() { return false; }
+
+bool SdSpiCard::reinitAfterFailure() {
+  if (!m_reinitValid) {
+    return false;
+  }
+  const SdSpiConfig config(m_reinitCsPin, m_reinitOptions, m_reinitMaxSck, m_reinitPort);
+  if (begin(config)) {
+    return true;
+  }
+  return sdfat_power_cycle_hook() && begin(config);
+}
+// After the second failure initialize the card again (cutting its supply if that
+// fails); after the third, cut its supply anyway: a card can accept a new begin()
+// and still not read.
+bool SdSpiCard::recoverAfterFailure(uint8_t attempt) {
+  if (attempt == 1) {
+    return reinitAfterFailure();
+  }
+  if (attempt == 2 && m_reinitValid) {
+    return sdfat_power_cycle_hook() &&
+           begin(SdSpiConfig(m_reinitCsPin, m_reinitOptions, m_reinitMaxSck, m_reinitPort));
+  }
+  return attempt == 0;
+}
+//------------------------------------------------------------------------------
+bool SdSpiCard::readSectors(Sector_t sector, uint8_t* dst, size_t ns) {
+  for (uint8_t attempt = 0; attempt < 4; attempt++) {
+    if (readSectorsOnce(sector, dst, ns)) {
+      return true;
+    }
+    SD_RETRY_LOG("read", sector, this);
+    if (!recoverAfterFailure(attempt)) {
+      SD_RETRY_LOG("recovery for", sector, this);
+      return false;
+    }
+  }
+  return false;
+}
+//------------------------------------------------------------------------------
+bool SdSpiCard::writeSector(Sector_t sector, const uint8_t* src) {
+  for (uint8_t attempt = 0; attempt < 4; attempt++) {
+    if (writeSectorOnce(sector, src)) {
+      return true;
+    }
+    SD_RETRY_LOG("write", sector, this);
+    if (!recoverAfterFailure(attempt)) {
+      SD_RETRY_LOG("recovery for", sector, this);
+      return false;
+    }
+  }
+  return false;
+}
+//------------------------------------------------------------------------------
+bool SdSpiCard::writeSectors(Sector_t sector, const uint8_t* src, size_t ns) {
+  for (uint8_t attempt = 0; attempt < 4; attempt++) {
+    if (writeSectorsOnce(sector, src, ns)) {
+      return true;
+    }
+    SD_RETRY_LOG("write", sector, this);
+    if (!recoverAfterFailure(attempt)) {
+      SD_RETRY_LOG("recovery for", sector, this);
+      return false;
+    }
+  }
+  return false;
+}
